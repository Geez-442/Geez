# ZETS Production Environment Example
# Copy this file to .env and replace the placeholder secrets.

# PostgreSQL (used by docker-compose and the API)
DATABASE_URL=postgres://zets:zets_dev_password@localhost:5432/zets_dev

# API security
JWT_SECRET=replace_with_a_long_random_secret
ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_base64_key

# Web CORS origin (allowed frontend origin for API requests)
CORS_ORIGIN=http://localhost:3000

# Optional: activate the real ZETA LLM backend for natural-language phrasing.
# Leave EMPTY to use the deterministic grounded knowledge-base responses.
# Do not paste a placeholder value here — an invalid key is detected and ignored,
# but leaving it blank avoids a pointless network round-trip on every question.
OPENAI_API_KEY=
