# ZETS Production Environment Example
# Copy this file to .env and replace the placeholder secrets.

# PostgreSQL (used by docker-compose and the API)
DATABASE_URL=postgres://zets:zets_dev_password@localhost:5432/zets_dev

# API security
JWT_SECRET=replace_with_a_long_random_secret
ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_base64_key

# Web CORS origin (allowed frontend origin for API requests)
CORS_ORIGIN=http://localhost:3000

# Optional: activate the real ZETA LLM backend.
# If unset, ZETA falls back to a deterministic local response.
OPENAI_API_KEY=sk-...
